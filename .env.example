# ─── Telegram (same as your Vinted bots) ───
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Trading 212 API ───
# Generate from: T212 app > Settings > API (beta)
T212_API_KEY=your_api_key
T212_API_SECRET=your_api_secret
T212_ENVIRONMENT=demo   # Start with "demo", switch to "live" when confident

# ─── Bot Settings ───
POLL_INTERVAL=3600          # Check every hour (seconds)
WEIGHTING_METHOD=conviction # "conviction" (recommended), "equal", or "volume"
MIN_MEMBER_OVERLAP=1        # Min members holding a stock to include it
MAX_PIE_STOCKS=50           # T212 pie limit is 50
PIE_NAME=Congress Top 10 Tracker
